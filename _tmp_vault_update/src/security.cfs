import "core.cfs";

use Vault.Core;

namespace Vault.Security {
    class KdfService() {
        static property default_iterations { get; } = 210000;

        static func create(iterations = 210000) {
            return {
                "algorithm": "PBKDF2-HMAC-SHA256",
                "iterations": iterations,
                "salt": crypto.randomBytes(16, "base64"),
                "keyBytes": 32
            };
        }

        static func derive(password, kdf) {
            if (Text.is_blank(password)) {
                throw "Password must not be empty.";
            }
            var salt = crypto.blob(kdf["salt"], "base64");
            return crypto.pbkdf2(str(password), salt, kdf["iterations"], kdf["keyBytes"], "sha256", "blob");
        }
    }

    class VaultCipher() {
        static func encrypt_text(password, kdf, text, aad) {
            var key = KdfService.derive(password, kdf);
            return crypto.aesGcmEncrypt(key, str(text), null, aad, "utf8", "base64");
        }

        static func decrypt_text(password, kdf, packet) {
            var key = KdfService.derive(password, kdf);
            return crypto.aesGcmDecrypt(key, packet, "base64", "utf8");
        }

        static func encrypt_bytes(file_key, bytes, aad) {
            return crypto.aesGcmEncrypt(file_key, bytes, null, aad, "bytes", "base64");
        }

        static func decrypt_bytes(file_key, packet) {
            return crypto.aesGcmDecrypt(file_key, packet, "base64", "bytes");
        }
    }

    class KeyManager() {
        static func create_key_container(path, password, bits = 2048) {
            var rsa = crypto.rsa(bits);
            KeyManager.save_private_key(path, rsa.private_pem(), password);
            KeyManager.write_text(KeyManager.public_key_path(path), rsa.public_pem());
            var public_pem = rsa.public_pem();
            rsa.close();
            return public_pem;
        }

        static func save_private_key(path, private_pem, password) {
            var dir = getDirectory(path);
            if (dir != null && str(dir).trim() != "") {
                dir.dirinfo().existsOrCreate();
            }
            var rsa = crypto.rsaFromPem(private_pem);
            var public_pem = rsa.public_pem();
            var kdf = KdfService.create();
            var encrypted = VaultCipher.encrypt_text(password, kdf, private_pem, "TheVault.KeyContainer:v1");
            var container = {
                "format": "Cfgs.TheVault.KeyContainer",
                "version": 1,
                "publicPem": public_pem,
                "kdf": kdf,
                "privateKey": encrypted
            };
            KeyManager.write_text(path, json.stringify(container));
            KeyManager.write_text(KeyManager.public_key_path(path), public_pem);
            rsa.close();
            return container;
        }

        static func load_private_key(path, password) {
            if (!fs.exists(path)) {
                throw "Private key file not found: " + path;
            }
            var text = KeyManager.read_text(path).trim();
            if (text.startsWith("-----BEGIN")) {
                return crypto.rsaFromPem(text);
            }
            var container = json.parse(text);
            if (container["format"] != "Cfgs.TheVault.KeyContainer") {
                throw "Unsupported key container format.";
            }
            var pem = VaultCipher.decrypt_text(password, container["kdf"], container["privateKey"]);
            return crypto.rsaFromPem(pem);
        }

        static func public_key_path(private_key_path) {
            var dir = getDirectory(private_key_path);
            var name = str(private_key_path).replace("\\", "/").split("/");
            var file_name = name[len(name) - 1];
            var dot = file_name.lastIndexOf(".");
            var base_name = dot > 0 ? file_name.substr(0, dot) : file_name;
            return (dir == null || str(dir).trim() == "" ? "." : dir) + "/" + base_name + ".pub.pem";
        }

        static func user_id(public_pem) {
            return crypto.hash(str(public_pem).replace("\r\n", "\n").trim() + "\n", "sha256", "utf8", "hex");
        }

        static func wrap_file_key(public_pem, file_key) {
            var rsa = crypto.rsaFromPem(public_pem);
            var wrapped = rsa.encrypt(file_key.base64(), "utf8", "base64", "oaep-sha256");
            rsa.close();
            return wrapped;
        }

        static func unwrap_file_key(private_key, wrapped_key) {
            var file_key_base64 = private_key.decrypt(wrapped_key, "base64", "utf8", "oaep-sha256");
            return crypto.blob(file_key_base64, "base64");
        }

        static func sign(private_key, operation_json) {
            return private_key.sign(operation_json, "sha256", "utf8", "base64", "pss");
        }

        static func read_text(path) {
            var f = fopen(path, 0);
            var count = fs.size(path);
            var text = count <= 0 ? "" : f.read(count);
            f.close();
            return text;
        }

        static func write_text(path, text) {
            var dir = getDirectory(path);
            if (!Text.is_blank(dir)) {
                dir.dirinfo().existsOrCreate();
            }
            var f = fopen(path, 2);
            f.write(text);
            f.close();
            return len(str(text));
        }
    }
}
