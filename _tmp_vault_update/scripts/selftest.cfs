import "C:/Users/Trainee5/source/repos/BlackFoX1991/ConfigurationScript-VM/dist/Debug/net10.0/CFGS.StandardLibrary.dll";
import "C:/Users/Trainee5/source/repos/BlackFoX1991/ConfigurationScript-VM/dist/Debug/net10.0/CFGS.Security.Crypto.dll";
import "../src/cli.cfs";

use Vault.Cli;

func assert_true(name, condition) {
    if (!condition) {
        throw "ASSERT_FAIL:" + name;
    }
}

async func run_command(args) {
    var app = new VaultApp();
    var code = await app.run(args);
    assert_true("exit_" + args[0], code == 0);
}

async func main() {
    var vault = "_tmp_cfgs_vault_selftest";
    if (vault.dirinfo().exists()) {
        vault.dirinfo().deleteDir(true);
    }

    await run_command(["init", "--path", vault, "--pass", "secret"]);
    await run_command(["mkdir", "--path", vault, "--pass", "secret", "--vpath", "/root/docs"]);
    await run_command(["write", "--path", vault, "--pass", "secret", "--vpath", "/root/docs/a.txt", "--text", "hello vault"]);
    await run_command(["copy", "--path", vault, "--pass", "secret", "--from", "/root/docs/a.txt", "--to", "/root/docs/b.txt"]);
    await run_command(["move", "--path", vault, "--pass", "secret", "--from", "/root/docs/b.txt", "--to", "/root/b.txt"]);
    await run_command(["export", "--path", vault, "--pass", "secret", "--vpath", "/root/b.txt", "--out", "_tmp_cfgs_vault_selftest_export.txt"]);

    assert_true("exported_file", fs.exists("_tmp_cfgs_vault_selftest_export.txt"));
    assert_true("exported_text", Vault.Storage.FileSystem.read_text("_tmp_cfgs_vault_selftest_export.txt") == "hello vault");

    print("CFGSVault selftest OK");
}

main();
