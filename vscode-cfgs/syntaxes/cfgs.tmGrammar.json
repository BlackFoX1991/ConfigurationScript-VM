{
  "scopeName": "source.cfgs",
  "name": "CFGS",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#receivers"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.cfgs",
          "begin": "#\\+(?=\\s|$)",
          "end": "\\+#"
        },
        {
          "name": "comment.line.number-sign.cfgs",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.interpolated.verbatim.double.cfgs",
          "begin": "(?:\\$@|@\\$)\"",
          "end": "\"(?!\")",
          "patterns": [
            {
              "name": "constant.character.escape.quote.cfgs",
              "match": "\"\""
            },
            {
              "name": "meta.interpolation.cfgs",
              "begin": "\\{(?!\\{)",
              "end": "\\}",
              "patterns": [
                {
                  "name": "constant.character.escape.brace.cfgs",
                  "match": "\\{\\{|\\}\\}"
                },
                {
                  "include": "#strings"
                },
                {
                  "include": "#numbers"
                },
                {
                  "include": "#declarations"
                },
                {
                  "include": "#keywords"
                },
                {
                  "include": "#receivers"
                },
                {
                  "include": "#operators"
                }
              ]
            },
            {
              "name": "constant.character.escape.brace.cfgs",
              "match": "\\{\\{|\\}\\}"
            }
          ]
        },
        {
          "name": "string.interpolated.double.cfgs",
          "begin": "\\$\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.cfgs",
              "match": "\\\\(?:[ntr\\\\\"']|u[0-9A-Fa-f]{4}|x[0-9A-Fa-f]{2})"
            },
            {
              "name": "meta.interpolation.cfgs",
              "begin": "\\{(?!\\{)",
              "end": "\\}",
              "patterns": [
                {
                  "name": "constant.character.escape.brace.cfgs",
                  "match": "\\{\\{|\\}\\}"
                },
                {
                  "include": "#strings"
                },
                {
                  "include": "#numbers"
                },
                {
                  "include": "#declarations"
                },
                {
                  "include": "#keywords"
                },
                {
                  "include": "#receivers"
                },
                {
                  "include": "#operators"
                }
              ]
            },
            {
              "name": "constant.character.escape.brace.cfgs",
              "match": "\\{\\{|\\}\\}"
            }
          ]
        },
        {
          "name": "string.verbatim.double.cfgs",
          "begin": "@\"",
          "end": "\"(?!\")",
          "patterns": [
            {
              "name": "constant.character.escape.quote.cfgs",
              "match": "\"\""
            }
          ]
        },
        {
          "name": "string.quoted.double.cfgs",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.cfgs",
              "match": "\\\\(?:[ntr\\\\\"']|u[0-9A-Fa-f]{4}|x[0-9A-Fa-f]{2})"
            }
          ]
        },
        {
          "name": "string.quoted.single.cfgs",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.cfgs",
              "match": "\\\\(?:[ntr\\\\\"']|u[0-9A-Fa-f]{4}|x[0-9A-Fa-f]{2})"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.cfgs",
          "match": "\\b(?:0[xX][0-9A-Fa-f_]+|0[bB][01_]+|0[oO][0-7_]+|\\d[\\d_]*(?:\\.\\d[\\d_]*)?(?:[eE][+-]?\\d[\\d_]*)?)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.cfgs",
          "match": "\\b(?:if|else|while|do|for|foreach|in|is|break|continue|return|match|case|default|try|catch|finally|throw|await|yield|using|defer)\\b"
        },
        {
          "name": "keyword.declaration.cfgs",
          "match": "\\b(?:var|const|import|use|export|from|as|static|public|private|protected|async|new|delete|property|index|native|get|set|init)\\b"
        },
        {
          "name": "constant.language.cfgs",
          "match": "\\b(?:true|false|null)\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(async\\s+)?(func)\\b(\\s+)([A-Za-z_][A-Za-z0-9_]*)(\\.)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.modifier.async.cfgs"
            },
            "2": {
              "name": "keyword.declaration.cfgs"
            },
            "4": {
              "name": "entity.name.type.interface.cfgs"
            },
            "6": {
              "name": "entity.name.function.member.cfgs"
            }
          }
        },
        {
          "match": "\\b(async\\s+)?(func)\\b(\\s+)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.modifier.async.cfgs"
            },
            "2": {
              "name": "keyword.declaration.cfgs"
            },
            "4": {
              "name": "entity.name.function.cfgs"
            }
          }
        },
        {
          "match": "\\b(class)\\b(\\s+)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.cfgs"
            },
            "3": {
              "name": "entity.name.type.class.cfgs"
            }
          }
        },
        {
          "match": "\\b(interface)\\b(\\s+)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.cfgs"
            },
            "3": {
              "name": "entity.name.type.interface.cfgs"
            }
          }
        },
        {
          "match": "\\b(enum)\\b(\\s+)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.cfgs"
            },
            "3": {
              "name": "entity.name.type.enum.cfgs"
            }
          }
        },
        {
          "match": "\\b(namespace)\\b(\\s+)([A-Za-z_][A-Za-z0-9_\\.]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.cfgs"
            },
            "3": {
              "name": "entity.name.namespace.cfgs"
            }
          }
        }
      ]
    },
    "receivers": {
      "patterns": [
        {
          "name": "variable.language.cfgs",
          "match": "\\b(?:this|type|super|outer|field)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.cfgs",
          "match": "(\\+\\+|--|\\+=|-=|\\*=|/=|%=|==|!=|<=|>=|&&|\\|\\||\\?\\?|\\*\\*|<<<|>>>|<<|>>|[+\\-*/%<>=!&|^~?:.,;])"
        }
      ]
    }
  }
}
