{
  "name": "cfgs-vscode",
  "displayName": "CFGS Language Tools",
  "description": "Visual Studio Code support for ConfigurationScript with CFGS LSP, formatter, and linter integration.",
  "version": "0.8.1",
  "publisher": "blackfox1991",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters"
  ],
  "activationEvents": [
    "onLanguage:cfgs",
    "onCommand:cfgs.restartServer",
    "onCommand:cfgs.lintFile",
    "onCommand:cfgs.lintWorkspace",
    "onCommand:cfgs.formatFile"
  ],
  "main": "./extension.js",
  "contributes": {
    "configurationDefaults": {
      "files.associations": {
        "*.cfs": "cfgs"
      },
      "[cfgs]": {
        "editor.defaultFormatter": "blackfox1991.cfgs-vscode",
        "editor.semanticHighlighting.enabled": true
      }
    },
    "languages": [
      {
        "id": "cfgs",
        "aliases": [
          "CFGS",
          "ConfigurationScript"
        ],
        "extensions": [
          ".cfs"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "cfgs",
        "scopeName": "source.cfgs",
        "path": "./syntaxes/cfgs.tmGrammar.json"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "cfgs",
        "scopes": {
          "namespace": ["entity.name.namespace"],
          "class": ["entity.name.type.class"],
          "interface": ["entity.name.type.interface"],
          "enum": ["entity.name.type.enum"],
          "enumMember": ["variable.other.enummember"],
          "function": ["entity.name.function"],
          "method": ["entity.name.function.member"],
          "parameter": ["variable.parameter"],
          "variable": ["variable.other"]
        }
      }
    ],
    "commands": [
      {
        "command": "cfgs.restartServer",
        "title": "CFGS: Restart Language Server"
      },
      {
        "command": "cfgs.lintFile",
        "title": "CFGS: Lint Current File"
      },
      {
        "command": "cfgs.lintWorkspace",
        "title": "CFGS: Lint Workspace"
      },
      {
        "command": "cfgs.formatFile",
        "title": "CFGS: Format Current File"
      }
    ],
    "configuration": {
      "title": "CFGS",
      "properties": {
        "cfgs.server.command": {
          "type": "string",
          "default": "",
          "description": "Optional command used to start the CFGS language server."
        },
        "cfgs.server.args": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Optional arguments used to start the CFGS language server."
        },
        "cfgs.server.cwd": {
          "type": "string",
          "default": "",
          "description": "Optional working directory for the CFGS language server process."
        },
        "cfgs.cli.command": {
          "type": "string",
          "default": "",
          "description": "Optional command used to run CFGS CLI tooling. Leave empty to auto-detect the bundled or workspace VM."
        },
        "cfgs.cli.args": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Optional base arguments for the CFGS CLI command."
        },
        "cfgs.lint.live": {
          "type": "boolean",
          "default": true,
          "description": "Show CFGS lint diagnostics (style and AST rules) live while typing, not only on save. Changing this restarts the language server."
        },
        "cfgs.lint.onSave": {
          "type": "boolean",
          "default": false,
          "description": "Run the CFGS lint CLI on the saved file into a separate collection. Redundant when cfgs.lint.live is on."
        },
        "cfgs.lint.fixOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Run CFGS lint --fix on save to auto-apply safe style fixes."
        }
      }
    }
  },
  "scripts": {
    "check": "node --check extension.js",
    "smoke": "node scripts/smoke-extension.js",
    "package": "node scripts/package-vsix.js"
  }
}
