import "dist/Debug/net10.0/CFGS.StandardLibrary.dll";
func now_ms() { return UtcNow("yyyy-MM-dd HH:mm:ss.fff").toDateTime("yyyy-MM-dd HH:mm:ss.fff").toUnixMilliseconds(); }
async func delayed(timer) { var _ = await timer.delay(80, null); return 1; }
async func immediate() { return 2; }
var timer = task();
var started = now_ms();
var slow = delayed(timer);
print("after_slow=" + str(now_ms() - started));
var fast = immediate();
print("after_fast=" + str(now_ms() - started));
print("fast=" + str(await fast) + ", elapsed=" + str(now_ms() - started));
print("slow=" + str(await slow) + ", elapsed=" + str(now_ms() - started));