# name: String concatenation
# units: 150000
# unit-label: concatenations
#
# Repeatedly appends to an immutable string with the + operator. Stresses the
# string path of ADD and the runtime's string building strategy.

func run(n) {
    var s = "";
    var i = 0;
    while (i < n) {
        s = s + "x";
        i = i + 1;
    }
    return len(s);
}

print(run(150000));
