# name: Dictionary insert + lookup
# units: 600000
# unit-label: keys
#
# Inserts N string-keyed entries then looks each up again. Stresses dictionary
# hashing, string key coercion (str), and bracket get/set.

func run(n) {
    var d = {};
    var i = 0;
    while (i < n) {
        d[str(i)] = i;
        i = i + 1;
    }

    var s = 0;
    var j = 0;
    while (j < n) {
        s = s + d[str(j)];
        j = j + 1;
    }
    return s;
}

print(run(600000));
