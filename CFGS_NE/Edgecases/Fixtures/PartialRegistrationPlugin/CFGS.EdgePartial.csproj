<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Test fixture for 506_plugin_register_failfast_fail.cfs: a plugin whose Register throws after it
    has already registered a builtin and an intrinsic. run_all_edgecases.ps1 builds it into
    Edgecases/_fixtures against the VM under test. It is not part of CFGS_VM.sln, so it never lands
    in dist/ or in a release.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>CFGS.EdgePartial</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- The VM assembly under test, passed by the runner; not copied, the host provides it. -->
    <Reference Include="CFGS_VM">
      <HintPath>$(CfgsVmAssembly)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
