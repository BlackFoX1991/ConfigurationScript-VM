import "edge_assert.cfs";
use std.regex;
use console;

edge_begin("249_standard_library_namespaces");

var firstMatch = regex.match("abc 42 def", "\\d+");
edge_eq("regex_namespace_match_value", firstMatch["matched"], "42");
edge_eq("regex_namespace_match_index", firstMatch["index"], 4);
edge_eq("regex_namespace_matches_len", len(regex.matches("a1 b22", "\\d+")), 2);
edge_eq("regex_namespace_replace", regex.replace("a b", "\\s+", "-"), "a-b");
edge_eq("regex_namespace_test", regex.test("abc42", "\\d+"), true);
edge_eq("regex_use_test", test("abc42", "\\d+"), true);
edge_eq("regex_namespace_split", regex.split("a,b", ",")[1], "b");

var obj = json.parse("{\"a\":1,\"b\":[2,3]}");
edge_eq("json_namespace_parse_value", obj["a"], 1);
edge_eq("json_namespace_parse_array", obj["b"][1], 3);
edge_true("json_namespace_stringify_has_key", json.stringify(obj).contains("\"a\""));

edge_eq("math_namespace_abs", math.abs(-5), 5);
edge_eq("math_namespace_round", math.round(1.6), 2);
edge_eq("math_namespace_min", math.min(3, 7), 3);
edge_eq("math_namespace_max", math.max(3, 7), 7);
edge_eq("math_namespace_pow", math.pow(2, 4), 16);
edge_true("math_namespace_pi", math.pi() > 3);

edge_eq("console_namespace_put_empty", console.put(""), 1);
edge_eq("console_use_put_empty", put(""), 1);

var sourcePath = "_tmp_standard_library_namespaces.bin";
var copyPath = "_tmp_standard_library_namespaces_copy.bin";

edge_eq("fs_namespace_write_bytes", fs.writeAllBytes(sourcePath, [65, 66, 67]), 3);
edge_true("fs_namespace_exists", fs.exists(sourcePath));
edge_eq("file_namespace_alias_size", file.size(sourcePath), 3);

var readBytes = fs.readAllBytes(sourcePath);
edge_eq("fs_namespace_read_byte", readBytes[1], 66);
edge_eq("fs_namespace_copy", fs.copy(sourcePath, copyPath, true), copyPath);
edge_true("fs_namespace_copy_exists", fs.exists(copyPath));
edge_eq("fs_namespace_delete_copy", fs.delete(copyPath), 1);
edge_eq("fs_namespace_delete_source", fs.delete(sourcePath), 1);
edge_throws("regex_factory_removed", func() { return regex(); });
edge_throws("console_factory_removed", func() { return console(); });

edge_finish("249_standard_library_namespaces");
