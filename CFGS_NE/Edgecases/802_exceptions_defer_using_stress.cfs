import "edge_assert.cfs";

edge_begin("802_exceptions_defer_using_stress");

# --- exception unwinds through several frames, defer fires at each level ---
var log = [];
func deepC() {
    defer log.push("C");
    throw "deep";
}
func deepB() {
    defer log.push("B");
    deepC();
}
func deepA() {
    try {
        defer log.push("A");
        deepB();
    } catch (e) {
        log.push("caught:" + str(e));
    }
}
deepA();
edge_eq("unwind_defer_C", log[0], "C");
edge_eq("unwind_defer_B", log[1], "B");
edge_eq("unwind_defer_A", log[2], "A");
edge_eq("unwind_caught", log[3], "caught:deep");

# --- nested try inside catch, with finally ordering ---
func nestedTryInCatch() {
    var s = "";
    try {
        throw 1;
    } catch (e) {
        s = s + "c1";
        try {
            throw 2;
        } catch (e2) {
            s = s + "c2";
        } finally {
            s = s + "f2";
        }
    } finally {
        s = s + "f1";
    }
    return s;
}
edge_eq("nested_try_in_catch", nestedTryInCatch(), "c1c2f2f1");

# --- finally return overrides a thrown exception ---
func finallyReturnSwallowsThrow() {
    try {
        throw "ignored";
    } finally {
        return "ok";
    }
}
edge_eq("finally_return_swallows", finallyReturnSwallowsThrow(), "ok");

# --- throw inside a loop, defer per-iteration still fires before unwinding ---
func loopThrow() {
    var marks = [];
    try {
        for (var i = 0; i < 5; i = i + 1) {
            defer marks.push("d" + str(i));
            if (i == 2) { throw "stop"; }
            marks.push("b" + str(i));
        }
    } catch (e) {
        marks.push("x");
    }
    return marks;
}
var lm = loopThrow();
edge_eq("loop_throw_b0", lm[0], "b0");
edge_eq("loop_throw_d0", lm[1], "d0");
edge_eq("loop_throw_b1", lm[2], "b1");
edge_eq("loop_throw_d1", lm[3], "d1");
edge_eq("loop_throw_d2_before_unwind", lm[4], "d2");
edge_eq("loop_throw_caught", lm[5], "x");

# --- rethrow preserves payload type (non-string) ---
func rethrowDict() {
    try {
        try {
            throw {"code": 42};
        } catch (e) {
            throw e;
        }
    } catch (e2) {
        return e2["code"];
    }
}
edge_eq("rethrow_dict_payload", rethrowDict(), 42);

# --- exception thrown from a captured-this lambda is catchable at the call site ---
class Risky() {
    var name = "risky";
    func operation() {
        return func() { throw this.name; };
    }
}
func runRisky() {
    var op = (new Risky()).operation();
    try {
        op();
        return "no-throw";
    } catch (e) {
        return "caught:" + str(e);
    }
}
edge_eq("lambda_throw_caught", runRisky(), "caught:risky");

# --- defer LIFO ordering with mixed body work ---
func deferLifo() {
    var o = [];
    defer o.push(1);
    defer o.push(2);
    defer o.push(3);
    o.push(0);
    return o;
}
var dl = deferLifo();
edge_eq("defer_lifo_body", dl[0], 0);
edge_eq("defer_lifo_3", dl[1], 3);
edge_eq("defer_lifo_2", dl[2], 2);
edge_eq("defer_lifo_1", dl[3], 1);

# --- catch without identifier + finally on the success path ---
func finallyOnSuccess() {
    var t = "";
    try {
        t = t + "T";
    } catch () {
        t = t + "C";
    } finally {
        t = t + "F";
    }
    return t;
}
edge_eq("finally_on_success", finallyOnSuccess(), "TF");

edge_finish("802_exceptions_defer_using_stress");
