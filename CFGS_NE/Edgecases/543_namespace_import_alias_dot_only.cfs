import * as Lib from "_imports/mod_exports_ns.cfs";
import "edge_assert.cfs";

edge_begin("543_namespace_import_alias_dot_only");

# A namespace import alias is a compile-time alias for the imported module surface, accessed
# exclusively through dot member syntax. Bracket access, an unknown export and the alias as a value
# are compile errors (843, 844 and 845).
edge_eq("dot_const", Lib.nanswer, 7);
edge_eq("dot_func", Lib.triple(6), 18);
edge_eq("dot_enum", Lib.Flag.On, 1);
edge_eq("dot_class", (new Lib.Crate(4)).get(), 4);

edge_finish("543_namespace_import_alias_dot_only");
