import "edge_assert.cfs";
use std.encoding;

edge_begin("248_encoding_builtins");

var allNames = encoding.names();
var namesViaNamespace = encoding.names();
var namesViaShortNamespace = encoding.names();
var namesViaUse = names();
edge_true("encoding_names_non_empty", len(allNames) > 0);
edge_true("encoding_namespace_names_non_empty", len(namesViaNamespace) > 0);
edge_true("encoding_short_namespace_names_non_empty", len(namesViaShortNamespace) > 0);
edge_true("encoding_use_names_non_empty", len(namesViaUse) > 0);
edge_true("has_utf8_name", encoding.has("utf-8"));
edge_true("encoding_namespace_has_utf8_name", encoding.has("utf-8"));
edge_true("encoding_short_namespace_has_utf8_name", encoding.has("utf-8"));
edge_true("encoding_use_has_utf8_name", has("utf-8"));
edge_true("has_utf8_codepage", encoding.has(65001));
edge_true("has_windows_1252", encoding.has("windows-1252"));
edge_eq("has_invalid_encoding", encoding.has("definitely-not-an-encoding"), false);
edge_eq("encoding_namespace_has_invalid", encoding.has("definitely-not-an-encoding"), false);

var utf8Info = encoding.info("utf-8");
edge_eq("utf8_info_codepage", utf8Info["codePage"], 65001);
edge_eq("encoding_namespace_info_codepage", encoding.info("utf-8")["codePage"], 65001);
edge_eq("encoding_short_namespace_info_codepage", encoding.info("utf-8")["codePage"], 65001);
edge_eq("encoding_use_info_codepage", info("utf-8")["codePage"], 65001);

var cpInfo = encoding.info("windows-1252");
edge_eq("windows_1252_codepage", cpInfo["codePage"], 1252);

var latinBytes = encoding.encode("Ä", "windows-1252");
edge_eq("encode_windows_1252_len", len(latinBytes), 1);
edge_eq("encode_windows_1252_byte", latinBytes[0], 196);
edge_eq("decode_windows_1252", encoding.decode([196], "windows-1252"), "Ä");

var latinBytesByCodePage = encoding.encode("Ä", 1252);
edge_eq("text_to_bytes_codepage_byte", latinBytesByCodePage[0], 196);

var utf8Bytes = encoding.convert([196], "windows-1252", "utf-8");
edge_eq("convert_encoding_utf8_len", len(utf8Bytes), 2);
edge_eq("convert_encoding_utf8_0", utf8Bytes[0], 195);
edge_eq("convert_encoding_utf8_1", utf8Bytes[1], 132);
edge_eq("convert_encoding_roundtrip", encoding.decode(utf8Bytes, "utf-8"), "Ä");

var tobytesLatin = tobytes("Ä", "windows-1252");
edge_eq("tobytes_encoding_byte", tobytesLatin[0], 196);

var asciiBytesViaNamespace = encoding.encode("ABC", "utf-8");
edge_eq("encoding_namespace_encode_len", len(asciiBytesViaNamespace), 3);
edge_eq("encoding_namespace_encode_0", asciiBytesViaNamespace[0], 65);
edge_eq("encoding_namespace_decode", encoding.decode([65, 66, 67], "utf-8"), "ABC");

var convertedAscii = encoding.convert([65, 66, 67], "utf-8", "utf-8");
edge_eq("encoding_namespace_convert_len", len(convertedAscii), 3);
edge_eq("encoding_namespace_convert_2", convertedAscii[2], 67);

var infos = encoding.all();
var infosViaNamespace = encoding.all();
edge_true("encodings_non_empty", len(infos) > 0);
edge_true("encoding_namespace_all_non_empty", len(infosViaNamespace) > 0);
edge_true("encoding_info_has_name", infos[0]["name"] != null);
edge_true("encoding_info_has_codepage", infos[0]["codePage"] != null);
edge_throws("encoding_factory_removed", func() { return encoding(); });

edge_finish("248_encoding_builtins");
