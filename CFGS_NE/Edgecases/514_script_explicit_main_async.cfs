import "edge_assert.cfs";

# CFGS has no auto-main: an async main() must be invoked explicitly. Top-level await works both
# bound (`var _ = await main();`) and as a bare statement (`await main();`, see 544).
async func main() {
    edge_begin("514_script_explicit_main_async");
    var _ = await nextTick();
    edge_eq("explicit_main_async_runs", 41 + 1, 42);
    edge_finish("514_script_explicit_main_async");
}

var _ = await main();
