import "edge_assert.cfs";

edge_begin("819_namespace_undefined_member");

namespace Modules.Masterdata {
    class Person(name) {
        var name = "";
        func init(name) { this.name = name; }
        func greet() { return "Hi " + this.name; }
    }

    func helper() { return 42; }
}

func run() {
    # Members of a namespace are resolved at compile time, so the defined path is a direct binding.
    var p = new Modules.Masterdata.Person("Bob");
    edge_eq("defined_class", p.greet(), "Hi Bob");
    edge_eq("defined_func", Modules.Masterdata.helper(), 42);
}

run();

# An undefined member is a compile error, not a runtime surprise:
# 840_namespace_unknown_member_fail, 841_namespace_unknown_segment_fail and
# 842_namespace_unknown_type_fail cover the read, the intermediate path, and the type position.

edge_finish("819_namespace_undefined_member");
