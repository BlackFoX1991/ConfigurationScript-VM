import "edge_assert.cfs";

edge_begin("522_foreach_global_dict_without_stdlib");

enum Locales
{
    DE,
    EN,
    ES,
    PL
}

var globalSymbols = {
    "Deutsch": Locales.DE,
    "Englisch": Locales.EN,
    "Spanisch": Locales.ES,
    "Polnisch": Locales.PL
};

func main() {
    var count = 0;
    var total = 0;
    var sawGerman = false;

    foreach (var key, value in globalSymbols) {
        count = count + 1;
        total = total + value;
        if (key == "Deutsch" && value == Locales.DE) {
            sawGerman = true;
        }
    }

    edge_eq("foreach_global_dict_count", count, 4);
    edge_eq("foreach_global_dict_enum_sum", total, 6);
    edge_true("foreach_global_dict_key_value_pair", sawGerman);
}

main();

edge_finish("522_foreach_global_dict_without_stdlib");
