import "../../../dist/Debug/net10.0/CFGS.StandardLibrary.dll";
import native "../../_edgecases/CFGS.EdgeAwaitables.dll" as Net;

var failed = 0;

func assert_eq(name, actual, expected) {
    if (actual == expected) {
        print("OK   " + name + " = " + str(actual));
    } else {
        print("FAIL " + name + " -> got " + str(actual) + ", expected " + str(expected));
        failed = failed + 1;
    }
}

func finish(tag) {
    if (failed == 0) {
        print("ALL PASSED: " + tag);
    } else {
        print("FAILED: " + tag + " (" + str(failed) + ")");
    }
}

func multiply(a, b) {
    return a * b;
}

func main() {
    var box = Net.CFGS.EdgeAwaitables.EdgeNativeBox.new(10);

    assert_eq("native_optional_named_args", box.OptionalJoin("A", right: "Z"), "A:M:Z");
    assert_eq("native_params_array", box.SumParams("sum", 1, 2, 3, 4), 10);
    assert_eq("native_indexer_get", box[2], "idx:2:10");
    box[2] = "44";
    assert_eq("native_indexer_set", box.Value, 44);
    assert_eq("native_closure_delegate_arg", box.UseBinary(3, 4, multiply), 12);

    var total = 0;
    func on_number(v) {
        total = total + v;
    }

    box.NumberChanged.add(on_number);
    box.RaiseNumber(7);
    assert_eq("native_event_add", total, 7);

    box.NumberChanged.remove(on_number);
    box.RaiseNumber(5);
    assert_eq("native_event_remove", total, 7);

    finish("native_delegate_event_optional");
}
