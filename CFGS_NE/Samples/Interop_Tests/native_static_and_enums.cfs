import "../../../dist/Debug/net10.0/CFGS.StandardLibrary.dll";
import native "../../../dist/Debug/net10.0/CFGS_VM.dll" as Vm;

var failed = 0;

func assert_eq(name, actual, expected) {
    if (actual == expected) {
        print("OK   " + name + " = " + str(actual));
    } else {
        print("FAIL " + name + " -> got " + str(actual) + ", expected " + str(expected));
        failed = failed + 1;
    }
}

func finish(tag) {
    if (failed == 0) {
        print("ALL PASSED: " + tag);
    } else {
        print("FAILED: " + tag + " (" + str(failed) + ")");
    }
}

func main() {
    assert_eq("native_static_method_true", Vm.CFGS_VM.VMCore.VM.IsNumber(123), true);
    assert_eq("native_static_method_false", Vm.CFGS_VM.VMCore.VM.IsNumber("123"), false);

    var token = Vm.Token.new(Vm.CFGS_VM.Analytic.Tokens.TokenType.Ident, "name", 12, 4, "sample.cfs");
    assert_eq("native_enum_argument", token.Type, Vm.CFGS_VM.Analytic.Tokens.TokenType.Ident);
    assert_eq("native_constructor_value", token.Value, "name");
    assert_eq("native_constructor_line", token.Line, 12);

    finish("native_static_and_enums");
}
