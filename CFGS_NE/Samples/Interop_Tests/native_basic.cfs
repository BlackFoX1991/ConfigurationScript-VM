import "../../../dist/Debug/net10.0/CFGS.StandardLibrary.dll";
import native "../../../dist/Debug/net10.0/CFGS_VM.dll" as Vm;

var failed = 0;

func assert_eq(name, actual, expected) {
    if (actual == expected) {
        print("OK   " + name + " = " + str(actual));
    } else {
        print("FAIL " + name + " -> got " + str(actual) + ", expected " + str(expected));
        failed = failed + 1;
    }
}

func finish(tag) {
    if (failed == 0) {
        print("ALL PASSED: " + tag);
    } else {
        print("FAILED: " + tag + " (" + str(failed) + ")");
    }
}

func main() {
    var named = Vm.CFGS_VM.VMCore.Extensions.Core.NamedArgument.new("host", "localhost");
    var instance = Vm.CFGS_VM.VMCore.Extensions.Instance.ClassInstance.new("DemoBox");

    assert_eq("native_constructor", named.Name, "host");
    assert_eq("native_property", named.Value, "localhost");
    assert_eq("native_second_type", instance.ClassName, "DemoBox");
    assert_eq("native_static_method", Vm.CFGS_VM.VMCore.VM.IsNumber(42), true);

    finish("native_basic");
}
