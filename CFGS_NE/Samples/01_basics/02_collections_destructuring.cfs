
# This sample demonstrates arrays, dictionaries, slices, delete,
# destructuring, foreach pairs, and the `out` expression block.

func ensure(label, condition) {
    if (!condition) {
        throw "sample failed: " + label;
    }
}

func main() {
    # Arrays support append with `[]`, indexed access, and slicing.
    var numbers = [10, 20, 30];
    numbers[] = 40;
    ensure("array append", len(numbers) == 4 && numbers[3] == 40);

    var firstTwo = numbers[~2];
    var tail = numbers[2~];
    var middle = numbers[1~3];
    ensure("slice head", firstTwo[0] == 10 && firstTwo[1] == 20);
    ensure("slice tail", tail[0] == 30 && tail[1] == 40);
    ensure("slice middle", middle[0] == 20 && middle[1] == 30);

    # Slice assignment replaces the selected range.
    numbers[1~3] = [21, 22];
    ensure("slice assignment", len(numbers) == 4 && numbers[1] == 21 && numbers[2] == 22);

    # Delete works on indexes, slices, whole collections, and dictionary keys.
    delete numbers[2];
    ensure("delete index", len(numbers) == 3 && numbers[2] == 40);

    delete numbers[1~3];
    ensure("delete slice", len(numbers) == 1 && numbers[0] == 10);

    var config = {"host": "localhost", "port": 8080};
    config["scheme"] = "https";
    config["timeout"] = 30;
    ensure("dictionary index", config["scheme"] == "https" && config["timeout"] == 30);

    delete config["port"];
    ensure("dictionary delete", config["port"] == null);

    # Dictionaries can be merged with the push form.
    config[] = {"region": "EU"};
    ensure("dictionary push", config["region"] == "EU");

    # Destructuring binds nested array and dictionary shapes.
    var payload = {"id": 17, "tags": ["new", "paid"], "owner": {"name": "Ada"}};
    const {id, tags: [firstTag, secondTag], owner: {name}} = payload;
    ensure("dictionary destructuring", id == 17 && firstTag == "new" && name == "Ada");
    ensure("destructuring source still usable", payload["id"] == id);

    var [left, right] = [3, 9];
    ensure("array destructuring", left + right == 12);

    # Destructuring also works in assignment.
    var a = 0;
    var b = 0;
    [a, b] = [b + 2, a + 5];
    ensure("destructuring assignment", a == 2 && b == 5);

    # Foreach can iterate values or key/value pairs.
    var total = 0;
    foreach (var value in [1, 2, 3]) {
        total = total + value;
    }
    ensure("foreach values", total == 6);

    var weighted = 0;
    foreach (var key, value in {"a": 2, "bb": 3}) {
        weighted = weighted + len(key) * value;
    }
    ensure("foreach key value", weighted == 8);

    # The `out` block evaluates to the last expression in its own scope.
    var summary = out {
        var local = id + len(secondTag);
        "item:" + str(local);
    };
    ensure("out block", summary == "item:21");

    print("COLLECTIONS_OK:" + summary);
}

main();
