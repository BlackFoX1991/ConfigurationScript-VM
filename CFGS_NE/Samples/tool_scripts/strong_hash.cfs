import "dist/Debug/net10.0/CFGS.StandardLibrary.dll";
import "dist/Debug/net10.0/CFGS.Security.Crypto.dll";

export class StrongHash(algorithm = "sha512", output = "hex") {
    public const algorithm;
    public const output;

    static const DefaultAlgorithm = "sha512";
    static const DefaultOutput = "hex";
    static const DefaultPasswordAlgorithm = "sha512";
    static const DefaultPasswordIterations = 310000;
    static const DefaultPasswordBytes = 64;
    static const DefaultSaltBytes = 16;

    func init(algorithm = "sha512", output = "hex") {
        type.assert_hash_algorithm(algorithm);
        type.assert_output(output);

        this.algorithm = algorithm;
        this.output = output;
    }

    func digest(value, inputEncoding = "utf8") {
        return crypto_hash(value, this.algorithm, inputEncoding, this.output);
    }

    func verify(value, expected, inputEncoding = "utf8", expectedEncoding = "auto") {
        var actual = this.digest(value, inputEncoding);
        return crypto_fixed_time_equals(actual, expected, this.output, expectedEncoding);
    }

    func hmac(key, value, inputEncoding = "utf8") {
        return crypto_hmac(key, value, this.algorithm, inputEncoding, this.output);
    }

    func verify_hmac(key, value, expected, inputEncoding = "utf8", expectedEncoding = "auto") {
        var actual = this.hmac(key, value, inputEncoding);
        return crypto_fixed_time_equals(actual, expected, this.output, expectedEncoding);
    }

    func file_digest(path) {
        var bytes = readAllBytes(path);
        return bytes.to_blob().hash(this.algorithm, this.output);
    }

    static func sha512(value, inputEncoding = "utf8", output = "hex") {
        type.assert_output(output);
        return crypto_hash(value, "sha512", inputEncoding, output);
    }

    static func sha256(value, inputEncoding = "utf8", output = "hex") {
        type.assert_output(output);
        return crypto_hash(value, "sha256", inputEncoding, output);
    }

    static func keyed(key, value, inputEncoding = "utf8", output = "hex") {
        type.assert_output(output);
        return crypto_hmac(key, value, "sha512", inputEncoding, output);
    }

    static func verify_keyed(key, value, expected, inputEncoding = "utf8", expectedEncoding = "auto", output = "hex") {
        var actual = type.keyed(key, value, inputEncoding, output);
        return crypto_fixed_time_equals(actual, expected, output, expectedEncoding);
    }

    static func password(password, iterations = 310000, keyBytes = 64) {
        type.assert_password_cost(iterations, keyBytes);

        var salt = crypto_random_bytes(type.DefaultSaltBytes, "blob");
        var hash = crypto_pbkdf2(password, salt, iterations, keyBytes, type.DefaultPasswordAlgorithm, "hex");

        return {
            "scheme": "pbkdf2",
            "algorithm": type.DefaultPasswordAlgorithm,
            "iterations": iterations,
            "saltBytes": type.DefaultSaltBytes,
            "keyBytes": keyBytes,
            "salt": salt.base64(),
            "hash": hash
        };
    }

    static func verify_password(password, record) {
        if (record == null) {
            return false;
        }

        if (record.scheme != "pbkdf2") {
            return false;
        }

        if (record.algorithm != type.DefaultPasswordAlgorithm) {
            return false;
        }

        type.assert_password_cost(record.iterations, record.keyBytes);

        var salt = crypto_blob(record.salt, "base64");
        var actual = crypto_pbkdf2(password, salt, record.iterations, record.keyBytes, record.algorithm, "hex");
        return crypto_fixed_time_equals(actual, record.hash, "hex", "hex");
    }

    static func assert_hash_algorithm(algorithm) {
        if (algorithm == "sha256") { return; }
        if (algorithm == "sha384") { return; }
        if (algorithm == "sha512") { return; }

        throw "StrongHash only accepts sha256, sha384, or sha512";
    }

    static func assert_output(output) {
        if (output == "hex") { return; }
        if (output == "base64") { return; }
        if (output == "blob") { return; }
        if (output == "bytes") { return; }

        throw "StrongHash output must be hex, base64, blob, or bytes";
    }

    static func assert_password_cost(iterations, keyBytes) {
        if (iterations < 100000) {
            throw "StrongHash password hashing requires at least 100000 PBKDF2 iterations";
        }

        if (keyBytes < 32) {
            throw "StrongHash password hashing requires at least 32 derived bytes";
        }
    }
}
