import "../../../dist/Debug/net10.0/CFGS.StandardLibrary.dll";
import "../../../dist/Debug/net10.0/CFGS.Web.Http.dll";

# CFGS HTTPS server sample.
# Erzeuge vorher ein PFX-Zertifikat und passe CERT_PATH/CERT_PASSWORD an.
# Beispiel mit dotnet dev-certs:
# dotnet dev-certs https -ep .\localhost-dev.pfx -p changeit

var PORT = 8443;
var CERT_PATH = get_workspace() + "\\localhost-dev.pfx";
var CERT_PASSWORD = "changeit";

async func main()
{
    var srv = http.server(PORT, {
        "https": true,
        "certificatePath": CERT_PATH,
        "certificatePassword": CERT_PASSWORD,
        "host": "localhost",
        "protocols": "http1"
    }).start();

    print("HTTPS server started on " + srv.url());
    print("Beenden ueber GET /exit");

    while(srv.is_running())
    {
        var req = srv.poll(1000);
        if(req == null)
        {
            put("");
        }
        else if(req.method == "GET" && req.path == "/exit")
        {
            srv.respond(req.id, 200, "{\"status\":\"stopping\"}", {"Content-Type":"application/json"});
            srv.stop();
        }
        else if(req.method == "GET" && req.path == "/health")
        {
            srv.respond(req.id, 200, "{\"status\":\"ok\",\"scheme\":\"" + req.scheme + "\",\"https\":" + str(req.is_https).lower() + "}", {"Content-Type":"application/json"});
        }
        else
        {
            srv.respond(req.id, 404, "{\"error\":\"not_found\"}", {"Content-Type":"application/json"});
        }
    }

    srv.close();
}

var _ = await main();
