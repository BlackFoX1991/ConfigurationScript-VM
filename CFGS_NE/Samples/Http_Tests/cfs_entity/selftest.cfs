import "entity.cfs";

use Cfs.Entity;

func assert_true(name, condition) {
    if (!condition) {
        throw "ASSERT_FAIL:" + name;
    }
}

func assert_eq(name, actual, expected) {
    if (actual != expected) {
        throw "ASSERT_FAIL:" + name + " got=" + str(actual) + " expected=" + str(expected);
    }
}

func build_user_model() {
    return new EntityModel("dbo", "CfgsEntitySelfTestUsers")
        .key("Id", "Id", "INT", true)
        .required("Name", "Name", "NVARCHAR(120)")
        .required("Email", "Email", "NVARCHAR(256)")
        .column("IsActive", "IsActive", "BIT", false, "1");
}

func build_user_model_v2() {
    return new EntityModel("dbo", "CfgsEntitySelfTestUsers")
        .key("Id", "Id", "INT", true)
        .required("Name", "Name", "NVARCHAR(120)")
        .required("Email", "Email", "NVARCHAR(256)")
        .column("IsActive", "IsActive", "BIT", false, "1")
        .column("LastLoginUtc", "LastLoginUtc", "DATETIME2", true);
}

func main() {
    var model = build_user_model();
    assert_eq("full_name", model.full_name, "[dbo].[CfgsEntitySelfTestUsers]");
    assert_true("create_sql_table", model.create_table_sql().contains("CREATE TABLE [dbo].[CfgsEntitySelfTestUsers]"));
    assert_true("create_sql_pk", model.create_table_sql().contains("CONSTRAINT [PK_CfgsEntitySelfTestUsers] PRIMARY KEY"));

    var db = new DbContext("Server=(local);Database=master;Encrypt=False;TrustServerCertificate=True;");
    var users = db.entity_set(model);
    var sql_text = users.query()
        .where_eq("IsActive", true)
        .order_by("Id", SortDirection["Desc"])
        .top(10)
        .to_sql(false);

    assert_true("select_top", sql_text.contains("SELECT TOP (10)"));
    assert_true("where_param", sql_text.contains("[IsActive] = @q0"));
    assert_true("order_desc", sql_text.contains("ORDER BY [Id] DESC"));

    var entry = users.add({
        "Name": "Ada",
        "Email": "ada@example.test",
        "IsActive": true
    });
    assert_eq("entry_state_added", entry.state, EntityState["Added"]);
    entry.state = EntityState["Unchanged"];
    entry.set_value("Email", "ada.lovelace@example.test");
    assert_eq("entry_state_modified", entry.state, EntityState["Modified"]);

    var snapshot_v1 = ModelSnapshot.from_models([model]);
    var snapshot_v2 = ModelSnapshot.from_models([build_user_model_v2()]);
    var plan = ModelDiffer.diff(snapshot_v1, snapshot_v2);
    assert_true("plan_has_changes", plan.has_changes());
    assert_eq("plan_one_op", len(plan.ops), 1);
    assert_eq("plan_add_column", plan.ops[0].kind, "add_column");
    assert_true("plan_sql", plan.executable_sql()[0].contains("ALTER TABLE [dbo].[CfgsEntitySelfTestUsers] ADD [LastLoginUtc] DATETIME2 NULL"));

    var changed_type = new EntityModel("dbo", "CfgsEntitySelfTestUsers")
        .key("Id", "Id", "INT", true)
        .required("Name", "Name", "NVARCHAR(200)")
        .required("Email", "Email", "NVARCHAR(256)")
        .column("IsActive", "IsActive", "BIT", false, "1");
    var rebuild_plan = ModelDiffer.diff(snapshot_v1, ModelSnapshot.from_models([changed_type]));
    assert_eq("rebuild_one_op", len(rebuild_plan.ops), 1);
    assert_eq("rebuild_kind", rebuild_plan.ops[0].kind, "rebuild_table");
    assert_true("rebuild_archive", rebuild_plan.ops[0].sql_text.contains("__CfgsEntityArchive_"));
    assert_true("rebuild_rename", rebuild_plan.ops[0].sql_text.contains("sp_rename"));

    var removed_column = new EntityModel("dbo", "CfgsEntitySelfTestUsers")
        .key("Id", "Id", "INT", true)
        .required("Name", "Name", "NVARCHAR(120)")
        .column("IsActive", "IsActive", "BIT", false, "1");
    var drop_column_plan = ModelDiffer.diff(snapshot_v1, ModelSnapshot.from_models([removed_column]));
    assert_eq("drop_column_rebuild_kind", drop_column_plan.ops[0].kind, "rebuild_table");

    var drop_table_plan = ModelDiffer.diff(snapshot_v1, ModelSnapshot.from_models([]));
    assert_eq("drop_table_archived", drop_table_plan.ops[0].kind, "archive_table");
    assert_true("drop_table_sql_rename", drop_table_plan.ops[0].sql_text.contains("sp_rename"));

    var required_column = new EntityModel("dbo", "CfgsEntitySelfTestUsers")
        .key("Id", "Id", "INT", true)
        .required("Name", "Name", "NVARCHAR(120)")
        .required("Email", "Email", "NVARCHAR(256)")
        .column("IsActive", "IsActive", "BIT", false, "1")
        .required("MustFill", "MustFill", "NVARCHAR(50)");
    var impossible_plan = ModelDiffer.diff(snapshot_v1, ModelSnapshot.from_models([required_column]));
    assert_eq("required_without_default_blocked", impossible_plan.blocked_operations()[0].kind, "blocked_required_column");

    var migration = new Migration(
        "202606160001_CreateUsers",
        "Create Users",
        async func(dbx) { return true; },
        async func(dbx) { return true; },
        snapshot_v1
    );
    assert_eq("migration_id", migration.id, "202606160001_CreateUsers");
    assert_true("migration_checksum", migration.checksum.contains(":"));

    print("CFS_ENTITY_SELFTEST_OK");
}

main();
