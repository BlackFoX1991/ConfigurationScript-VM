<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>assets\cfgs_icon.ico</ApplicationIcon>
  </PropertyGroup>


  <PropertyGroup>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>


  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <NoWarn>NU1510</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <NoWarn>NU1510</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Samples\plugins\**" />
    <EmbeddedResource Remove="Samples\plugins\**" />
    <None Remove="Samples\plugins\**" />
    <!-- Edge case test fixtures (for example the plugin projects under Edgecases\Fixtures) are built by
         run_all_edgecases.ps1, never as part of the VM. -->
    <Compile Remove="Edgecases\**" />
    <EmbeddedResource Remove="Edgecases\**" />
    <None Remove="Edgecases\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="assets\cfgs_icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Required by the built-in standard library's encoding namespace (CodePagesEncodingProvider). -->
    <PackageReference Include="System.Text.Encoding.CodePages" Version="10.0.8" />
    <!-- Windows service hosting (-as_service) and Windows Event Log access (eventlog namespace).
         Windows-only; all usages are guarded with OperatingSystem.IsWindows(). -->
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.0" />
    <PackageReference Include="System.Diagnostics.EventLog" Version="10.0.0" />
  </ItemGroup>

</Project>
