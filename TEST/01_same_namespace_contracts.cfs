namespace Feature.Showcase.Model;

interface IEntity {
    property id { get; }
}

interface IMetric {
    func metric(step);

    func describeMetric(step) {
        return "metric:" + str(this.metric(step));
    }
}

interface IRunner {
    func run(step);
}

class BaseRecord(idValue, seed) {
    property id { get; private set; } = "";
    protected var baseSeed = 0;

    func init(idValue, seed) {
        this.id = idValue;
        this.baseSeed = seed;
    }

    func kind() {
        return "base";
    }
}
