import "CFGS.StandardLibrary.dll";

namespace EffCopy
{
    class Paths()
    {
        static func normalize(path)
        {
            var p = str(path).replace("\\", "/");

            while (len(p) > 1 && p.endsWith("/")) {
                p = p.substr(0, len(p) - 1);
            }

            return p;
        }

        static func compare_key(path)
        {
            return type.normalize(path).lower();
        }

        static func basename(path)
        {
            var p = type.normalize(path);
            var slash = p.lastIndexOf("/");

            if (slash < 0) {
                return p;
            }

            return p.substr(slash + 1, len(p) - (slash + 1));
        }

        static func dirname(path)
        {
            var p = type.normalize(path);
            var slash = p.lastIndexOf("/");

            if (slash < 0) {
                return "";
            }

            if (slash == 0) {
                return "/";
            }

            return p.substr(0, slash);
        }

        static func join(left, right)
        {
            var l = type.normalize(left);
            var r = type.normalize(right);

            if (l == "") {
                return r;
            }

            if (r == "") {
                return l;
            }

            if (l.endsWith("/")) {
                return l + r;
            }

            return l + "/" + r;
        }

        static func relative_to(root, path)
        {
            var base = type.normalize(root);
            var full = type.normalize(path);
            var prefix = base + "/";

            if (full == base) {
                return "";
            }

            if (full.startsWith(prefix)) {
                return full.substr(len(prefix), len(full) - len(prefix));
            }

            return type.basename(full);
        }

        static func is_child_path(root, path)
        {
            var base = type.compare_key(root);
            var full = type.compare_key(path);

            return full.startsWith(base + "/");
        }
    }

    class Reporter()
    {
        static func usage()
        {
            print("EffCopy - async byte-wise file and directory copy/cut");
            print("");
            print("Usage:");
            print("  CFGS_VM EffCopy.cfs -p copy <source> <destination> [--overwrite] [--parallel <count>] [--chunk <bytes>] [--quiet]");
            print("  CFGS_VM EffCopy.cfs -p cut  <source> <destination> [--overwrite] [--parallel <count>] [--chunk <bytes>] [--quiet]");
            print("");
            print("Aliases:");
            print("  copy: cp");
            print("  cut : move, mv");
            print("");
            print("Options:");
            print("  --overwrite     Replace existing destination files.");
            print("  --force         Alias for --overwrite.");
            print("  --dry-run       Show what would be copied without writing or deleting.");
            print("  --quiet         Only print the summary.");
            print("  --no-progress   Disable the live progressbar and print progress as normal lines.");
            print("  --parallel <n>  Copy up to n files at the same time for directories. Default: 1.");
            print("  --jobs <n>      Alias for --parallel.");
            print("  --progress-ms <n> Refresh live progress every n milliseconds. Default: 100.");
            print("  --chunk <bytes> Read and write this many bytes per async step. Default: 65536.");
        }

        static func line(options, text)
        {
            if (!options["quiet"]) {
                print(text);
            }
        }

        static func repeat(ch, count)
        {
            var result = "";
            var i = 0;

            while (i < count) {
                result = result + ch;
                i = i + 1;
            }

            return result;
        }

        static func shorten(text, maxLen)
        {
            var value = str(text);

            if (len(value) <= maxLen) {
                return value;
            }

            if (maxLen <= 3) {
                return value.substr(0, maxLen);
            }

            return "..." + value.substr(len(value) - (maxLen - 3), maxLen - 3);
        }

        static func format_bytes(value)
        {
            if (value >= 1073741824) {
                return str(int((value * 10) / 1073741824) / 10) + " GB";
            }

            if (value >= 1048576) {
                return str(int((value * 10) / 1048576) / 10) + " MB";
            }

            if (value >= 1024) {
                return str(int((value * 10) / 1024) / 10) + " KB";
            }

            return str(value) + " B";
        }

        static func render_bar(pct, width)
        {
            var filled = int((pct * width) / 100);

            if (filled < 0) {
                filled = 0;
            }

            if (filled > width) {
                filled = width;
            }

            return "[" + type.repeat("#", filled) + type.repeat("-", width - filled) + "]";
        }

        static func progress_line(options, label, copied, total)
        {
            var pct = 100;
            if (total > 0) {
                pct = int((copied * 100) / total);
            }

            if (pct < 0) {
                pct = 0;
            }

            if (pct > 100) {
                pct = 100;
            }

            var bar = type.render_bar(pct, options["barWidth"]);
            var name = type.shorten(label, options["labelWidth"]);

            return "[EffCopy] " + bar + " " + str(pct).padStart(3, " ") + "% "
                + type.format_bytes(copied) + " / " + type.format_bytes(total)
                + "  " + name;
        }

        static func overall_progress_line(options, progress)
        {
            var copied = type.progress_copied(progress);
            var total = progress["totalBytes"];
            var pct = 100;

            if (total > 0) {
                pct = int((copied * 100) / total);
            }

            if (pct < 0) {
                pct = 0;
            }

            if (pct > 100) {
                pct = 100;
            }

            var bar = type.render_bar(pct, options["barWidth"]);
            return "[EffCopy] " + bar + " " + str(pct).padStart(3, " ") + "% "
                + type.format_bytes(copied) + " / " + type.format_bytes(total)
                + "  files " + str(type.progress_files(progress)) + "/" + str(progress["totalFiles"])
                + "  workers " + str(progress["workers"]);
        }

        static func progress_copied(progress)
        {
            var total = 0;

            foreach (var value in progress["workerBytes"]) {
                total = total + value;
            }

            return total;
        }

        static func progress_files(progress)
        {
            var total = 0;

            foreach (var value in progress["workerFiles"]) {
                total = total + value;
            }

            return total;
        }

        static func begin_progress(options)
        {
            if (!options["quiet"] && options["progress"]) {
                put("\x1b[?25l");
            }
        }

        static func end_progress(options, clearLine = false)
        {
            if (!options["quiet"] && options["progress"]) {
                if (clearLine) {
                    put("\r\x1b[2K");
                }
                put("\x1b[?25h");
            }
        }

        static func progress(options, label, copied, total, force = false)
        {
            if (options["quiet"]) {
                return;
            }

            var pct = 100;
            if (total > 0) {
                pct = int((copied * 100) / total);
            }

            if (options["progress"] || force || pct >= options["nextProgress"]) {
                var line = type.progress_line(options, label, copied, total);

                if (options["progress"]) {
                    put("\r\x1b[2K" + line);
                } else {
                    print(line);
                }

                options["nextProgress"] = pct + 5;
            }
        }

        static func progress_done(options, label, copied, total)
        {
            if (options["quiet"]) {
                return;
            }

            var line = type.progress_line(options, label, copied, total);

            if (options["progress"]) {
                put("\r\x1b[2K" + line);
                print("");
            } else {
                print(line);
            }
        }

        static func overall_progress(options, progress, force = false)
        {
            if (options["quiet"]) {
                return;
            }

            if (!options["progress"] && progress["workers"] > 1 && !force) {
                return;
            }

            var pct = 100;
            if (progress["totalBytes"] > 0) {
                pct = int((type.progress_copied(progress) * 100) / progress["totalBytes"]);
            }

            if (force || pct >= progress["nextProgress"]) {
                var line = type.overall_progress_line(options, progress);

                if (options["progress"]) {
                    put("\r\x1b[2K" + line);
                } else {
                    print(line);
                }

                progress["nextProgress"] = pct + 5;
            }
        }

        static func overall_progress_done(options, progress)
        {
            if (options["quiet"]) {
                return;
            }

            var line = type.overall_progress_line(options, progress);

            if (options["progress"]) {
                put("\r\x1b[2K" + line);
                print("");
            } else {
                print(line);
            }
        }

        static async func overall_progress_loop(options, progress)
        {
            while (!progress["done"]) {
                type.overall_progress(options, progress, true);
                var _wait = await sleep(options["progressMs"]);
                yield;
            }

            type.overall_progress_done(options, progress);
        }

        static func summary(mode, stats)
        {
            print("[EffCopy] " + mode + " complete: " + str(stats["files"]) + " file(s), " + str(stats["dirs"]) + " folder(s), " + str(stats["bytes"]) + " byte(s)");
        }

        static func error_text(err)
        {
            try {
                return err.message();
            } catch (ignored) {
                return str(err);
            }
        }
    }

    class Copier()
    {
        static func ensure_parent(path)
        {
            var parent = Paths.dirname(path);
            if (parent != "") {
                DirectoryInfo(parent).existsOrCreate();
            }
        }

        static func fail_if_target_exists(path, options)
        {
            if (!options["overwrite"] && fexist(path)) {
                throw "Destination file already exists: " + path + " (use --overwrite)";
            }
        }

        static async func copy_file(source, destination, options, stats, label = null, progress = null, workerId = 1)
        {
            if (label == null) {
                label = Paths.basename(source);
            }

            var size = fileSize(source);

            if (options["dryRun"]) {
                Reporter.line(options, "[EffCopy] DRY file " + source + " -> " + destination + " (" + str(size) + " bytes)");
                stats["files"] = stats["files"] + 1;
                stats["bytes"] = stats["bytes"] + size;

                if (progress != null) {
                    progress["workerFiles"][workerId - 1] = progress["workerFiles"][workerId - 1] + 1;
                    progress["workerBytes"][workerId - 1] = progress["workerBytes"][workerId - 1] + size;
                }

                return;
            }

            type.fail_if_target_exists(destination, options);
            type.ensure_parent(destination);

            var input = null;
            var output = null;
            var copied = 0;

            if (progress == null) {
                options["nextProgress"] = 0;
            }

            try {
                input = fbopen(source, 0);
                output = fbopen(destination, 2);

                if (progress == null) {
                    Reporter.progress(options, label, 0, size, true);
                }

                while (copied < size) {
                    var remaining = size - copied;
                    var readCount = options["chunkSize"];

                    if (remaining < readCount) {
                        readCount = int(remaining);
                    }

                    var chunk = await input.readBytesAsync(readCount);
                    var chunkLen = len(chunk);

                    if (chunkLen <= 0) {
                        break;
                    }

                    var _w = await output.writeBytesAsync(chunk);
                    copied = copied + chunkLen;

                    if (progress != null) {
                        progress["workerBytes"][workerId - 1] = progress["workerBytes"][workerId - 1] + chunkLen;
                    } else if (copied < size) {
                        Reporter.progress(options, label, copied, size);
                    }
                    yield;
                }

                var _f = await output.flushAsync();
                if (progress == null) {
                    Reporter.progress_done(options, label, copied, size);
                }
            } finally {
                if (input != null) {
                    input.close();
                }

                if (output != null) {
                    output.close();
                }
            }

            if (copied != size) {
                throw "Incomplete copy for " + source + ": copied " + str(copied) + " of " + str(size) + " bytes.";
            }

            stats["files"] = stats["files"] + 1;
            stats["bytes"] = stats["bytes"] + copied;

            if (progress != null) {
                progress["workerFiles"][workerId - 1] = progress["workerFiles"][workerId - 1] + 1;
            }
        }

        static func build_plan(sourceRoot)
        {
            var root = DirectoryInfo(sourceRoot);
            var dirs = root.getDirectories("*", true);
            var files = root.getFiles("*", true);
            var totalBytes = 0;

            foreach (var file in files) {
                totalBytes = totalBytes + fileSize(file);
            }

            return {
                "root": root.fullName(),
                "dirs": dirs,
                "files": files,
                "bytes": totalBytes
            };
        }

        static func validate_directory_targets(plan, destinationRoot, options)
        {
            foreach (var file in plan["files"]) {
                var rel = Paths.relative_to(plan["root"], file);
                var target = Paths.join(destinationRoot, rel);
                type.fail_if_target_exists(target, options);
            }
        }

        static async func copy_directory(source, destination, options, stats)
        {
            var plan = type.build_plan(source);
            var sourceRoot = plan["root"];
            var destinationRoot = DirectoryInfo(destination).fullName();

            if (Paths.is_child_path(sourceRoot, destinationRoot)) {
                throw "Destination cannot be inside the source directory.";
            }

            type.validate_directory_targets(plan, destinationRoot, options);

            Reporter.line(options, "[EffCopy] directory " + sourceRoot + " -> " + destinationRoot);
            Reporter.line(options, "[EffCopy] plan: " + str(len(plan["files"])) + " file(s), " + str(len(plan["dirs"])) + " subfolder(s), " + str(plan["bytes"]) + " byte(s), parallel " + str(options["parallel"]));

            if (!options["dryRun"]) {
                DirectoryInfo(destinationRoot).existsOrCreate();
            }

            foreach (var dir in plan["dirs"]) {
                var relDir = Paths.relative_to(sourceRoot, dir);
                var targetDir = Paths.join(destinationRoot, relDir);

                if (options["dryRun"]) {
                    Reporter.line(options, "[EffCopy] DRY dir  " + dir + " -> " + targetDir);
                } else {
                    DirectoryInfo(targetDir).existsOrCreate();
                }

                stats["dirs"] = stats["dirs"] + 1;
            }

            var fileCount = len(plan["files"]);
            if (fileCount == 0) {
                return;
            }

            var workers = options["parallel"];
            if (workers < 1) {
                workers = 1;
            }

            if (workers > fileCount) {
                workers = fileCount;
            }

            var workerBytes = [];
            var workerFiles = [];
            var wi = 0;
            while (wi < workers) {
                workerBytes.push(0);
                workerFiles.push(0);
                wi = wi + 1;
            }

            var progress = {
                "workerBytes": workerBytes,
                "workerFiles": workerFiles,
                "totalBytes": plan["bytes"],
                "totalFiles": fileCount,
                "nextProgress": 0,
                "workers": workers,
                "done": false
            };

            var displayTask = null;

            if (options["progress"]) {
                displayTask = Reporter.overall_progress_loop(options, progress);
            } else {
                Reporter.overall_progress(options, progress, true);
            }

            try {
                if (options["dryRun"] || workers == 1) {
                    foreach (var file in plan["files"]) {
                        var rel = Paths.relative_to(sourceRoot, file);
                        var target = Paths.join(destinationRoot, rel);
                        var _seq = await type.copy_file(file, target, options, stats, rel, progress, 1);
                    }
                } else {
                    var tasks = [];
                    var i = 0;

                    while (i < workers) {
                        tasks.push(type.copy_worker(i + 1, plan, destinationRoot, options, stats, progress));
                        i = i + 1;
                    }

                    var _workers = await tasks;
                }
            } finally {
                progress["done"] = true;
                if (displayTask != null) {
                    var _display = await displayTask;
                }
            }

            if (!options["progress"]) {
                Reporter.overall_progress_done(options, progress);
            }
            stats["files"] = fileCount;
            stats["bytes"] = plan["bytes"];
        }

        static async func copy_worker(workerId, plan, destinationRoot, options, stats, progress)
        {
            var idx = workerId - 1;

            while (idx < len(plan["files"])) {
                var file = plan["files"][idx];
                var rel = Paths.relative_to(plan["root"], file);
                var target = Paths.join(destinationRoot, rel);
                var _ = await type.copy_file(file, target, options, stats, rel, progress, workerId);
                idx = idx + progress["workers"];
            }

            return workerId;
        }
    }

    class Program()
    {
        static func is_mode(value)
        {
            var v = str(value).lower();
            return v == "copy" || v == "cp" || v == "cut" || v == "move" || v == "mv";
        }

        static func normalize_mode(value)
        {
            var v = str(value).lower();

            if (v == "cp") {
                return "copy";
            }

            if (v == "move" || v == "mv") {
                return "cut";
            }

            return v;
        }

        static func parse_args(args)
        {
            var options = {
                "mode": "copy",
                "source": "",
                "destination": "",
                "overwrite": false,
                "dryRun": false,
                "quiet": false,
                "progress": true,
                "barWidth": 32,
                "labelWidth": 48,
                "parallel": 1,
                "progressMs": 100,
                "chunkSize": 65536,
                "help": false,
                "nextProgress": 0
            };

            var positional = [];
            var i = 0;

            if (len(args) > 0 && type.is_mode(args[0])) {
                options["mode"] = type.normalize_mode(args[0]);
                i = 1;
            }

            while (i < len(args)) {
                var a = str(args[i]);

                if (a == "--help" || a == "-h") {
                    options["help"] = true;
                } else if (a == "--overwrite" || a == "-f" || a == "--force") {
                    options["overwrite"] = true;
                } else if (a == "--dry-run") {
                    options["dryRun"] = true;
                } else if (a == "--quiet" || a == "-q") {
                    options["quiet"] = true;
                } else if (a == "--no-progress") {
                    options["progress"] = false;
                } else if (a == "--parallel" || a == "--jobs") {
                    i = i + 1;
                    if (i >= len(args)) {
                        throw a + " requires a worker count.";
                    }
                    options["parallel"] = int(args[i]);
                } else if (a == "--progress-ms") {
                    i = i + 1;
                    if (i >= len(args)) {
                        throw "--progress-ms requires a millisecond value.";
                    }
                    options["progressMs"] = int(args[i]);
                } else if (a == "--chunk") {
                    i = i + 1;
                    if (i >= len(args)) {
                        throw "--chunk requires a byte count.";
                    }
                    options["chunkSize"] = int(args[i]);
                } else {
                    positional.push(a);
                }

                i = i + 1;
            }

            if (len(positional) > 0 && type.is_mode(positional[0])) {
                options["mode"] = type.normalize_mode(positional[0]);

                var shifted = [];
                var j = 1;
                while (j < len(positional)) {
                    shifted.push(positional[j]);
                    j = j + 1;
                }
                positional = shifted;
            }

            if (options["help"]) {
                return options;
            }

            if (len(positional) != 2) {
                throw "Expected <source> and <destination>.";
            }

            if (options["chunkSize"] <= 0) {
                throw "--chunk must be greater than zero.";
            }

            if (options["parallel"] <= 0) {
                throw "--parallel must be greater than zero.";
            }

            if (options["progressMs"] <= 0) {
                throw "--progress-ms must be greater than zero.";
            }

            options["source"] = positional[0];
            options["destination"] = positional[1];
            return options;
        }

        static func resolve_destination_for_file(source, destination)
        {
            if (DirectoryInfo(destination).exists()) {
                return Paths.join(destination, Paths.basename(source));
            }

            return destination;
        }

        static func delete_source_after_cut(source, isDirectory, options)
        {
            if (options["mode"] != "cut") {
                return;
            }

            if (options["dryRun"]) {
                Reporter.line(options, "[EffCopy] DRY delete source " + source);
                return;
            }

            if (isDirectory) {
                DirectoryInfo(source).deleteDir(true);
            } else {
                fdelete(source);
            }
        }

        static async func run_operation(options)
        {
            var source = options["source"];
            var destination = options["destination"];
            var stats = {"files": 0, "dirs": 0, "bytes": 0};

            var sourceIsFile = fexist(source);
            var sourceIsDirectory = DirectoryInfo(source).exists();

            if (!sourceIsFile && !sourceIsDirectory) {
                throw "Source does not exist: " + source;
            }

            if (sourceIsFile) {
                var targetFile = type.resolve_destination_for_file(source, destination);

                if (Paths.compare_key(DirectoryInfo(source).fullName()) == Paths.compare_key(DirectoryInfo(targetFile).fullName())) {
                    throw "Source and destination are the same file.";
                }

                var _file = await Copier.copy_file(source, targetFile, options, stats, Paths.basename(source));
                type.delete_source_after_cut(source, false, options);
            } else {
                var _dir = await Copier.copy_directory(source, destination, options, stats);
                type.delete_source_after_cut(source, true, options);
            }

            Reporter.end_progress(options);
            Reporter.summary(options["mode"], stats);
        }

        static async func main()
        {
            var args = cmdArgs();
            var options = null;

            try {
                options = type.parse_args(args);

                if (options["help"]) {
                    Reporter.usage();
                    return 0;
                }

                Reporter.begin_progress(options);
                var _ = await type.run_operation(options);
                return 0;
            } catch (err) {
                if (options != null) {
                    Reporter.end_progress(options, true);
                }
                print("[EffCopy] error: " + Reporter.error_text(err));
                print("");
                Reporter.usage();
                return 1;
            }
        }
    }
}

var _ = await EffCopy.Program.main();
